# ShopExpress environment
# Copy this file to .env and adjust the values for your machine.

# MongoDB connection string. The default points at a local database.
MONGODB_URI=mongodb://127.0.0.1:27017/shopexpress

# HTTP port.
PORT=3000

# A long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Development bootstrap admin (created only when no admin exists and NODE_ENV
# is not "production"). The seed script uses the same values.
ADMIN_EMAIL=admin@shopexpress.com
ADMIN_PASSWORD=admin123

# Optional demo customer created by `npm run seed`.
DEMO_EMAIL=demo@shopexpress.com
DEMO_PASSWORD=demo1234

# Transactional email is optional. Without a SendGrid key the app still works;
# email sending is skipped with a warning.
SENDGRID_API_KEY=
MAIL_FROM=shop@shopexpress.com

# Public URL used in outgoing email links.
APP_URL=http://localhost:3000

# Set to "production" when deploying behind HTTPS.
NODE_ENV=development
